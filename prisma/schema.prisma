generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum BookingStatus {
  PENDING
  BOOKED
  ON_RENT
  RETURNED
  LATE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

model AdminUser {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isHidden     Boolean  @default(false)
  hiddenAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id                  String   @id @default(cuid())
  customerCode        String   @unique
  fullName            String
  phone               String   @unique // requested unique mobile number
  email               String?
  whatsappOptIn       Boolean  @default(true)
  address             String?
  city                String?
  notes               String?
  measurements        Json?
  totalBookings       Int      @default(0)
  totalSpent          Decimal  @default(0)
  isHiddenForAdmin    Boolean  @default(false)
  isDeletedByAdmin    Boolean  @default(false)
  deletedByAdminAt    DateTime?
  deletedBySuperAdmin Boolean  @default(false)
  deletedBySuperAt    DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bookings Booking[]
}

model Dress {
  id                   String   @id @default(cuid())
  dressCode             String   @unique // e.g. D001
  uniqueName            String
  type                  String
  size                  String?
  color                 String?
  purchasePrice         Decimal
  rentalPrice           Decimal
  securityDeposit       Decimal?
  status                String   @default("AVAILABLE")
  timesRented           Int      @default(0)
  totalEarned           Decimal  @default(0)
  maintenanceCost       Decimal  @default(0)
  isHiddenForAdmin      Boolean  @default(false)
  isDeletedByAdmin      Boolean  @default(false)
  deletedByAdminAt      DateTime?
  deletedBySuperAdmin   Boolean  @default(false)
  deletedBySuperAt      DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  dressImages  DressImage[]
  bookingItems BookingItem[]
}

model DressImage {
  id        String   @id @default(cuid())
  dressId   String
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  dress Dress @relation(fields: [dressId], references: [id], onDelete: Cascade)
}

model Booking {
  id                 String        @id @default(cuid())
  bookingCode        String        @unique
  customerId         String
  startAt            DateTime
  endAt              DateTime
  dueAt              DateTime
  totalAmount        Decimal
  depositAmount      Decimal       @default(0)
  paidAmount         Decimal       @default(0)
  paymentStatus      PaymentStatus @default(PENDING)
  bookingStatus      BookingStatus @default(PENDING)
  whatsappSentAt     DateTime?
  whatsappStatus     String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id])
  bookingItems     BookingItem[]
  payments         Payment[]
  whatsappMessages WhatsAppMessage[]
}

model BookingItem {
  id          String   @id @default(cuid())
  bookingId   String
  dressId     String
  unitPrice   Decimal
  quantity    Int      @default(1)
  bookedAt    DateTime @default(now())
  returnedAt  DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  dress   Dress   @relation(fields: [dressId], references: [id])

  @@unique([bookingId, dressId])
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String
  amount      Decimal
  method      String
  status      PaymentStatus @default(PAID)
  paidAt      DateTime      @default(now())
  referenceNo String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  bookingId   String
  phone       String
  templateKey String
  payload     Json?
  status      String
  sentAt      DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
